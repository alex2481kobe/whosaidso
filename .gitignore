# Local coordination files are NOT in this repo - they live in the workspace
# folder above it, which is not a git repo. Nothing here guards against them.

# Go
/datum
/dist/
*.test
*.out
coverage.*

# Ledger working files. The lock lives inside the ledger directory by design,
# and a crash can leave a publication temporary. Neither is a record.
.datum/events/.lock
.datum/events/*.json.tmp

# OS / editor
.DS_Store
*.swp
